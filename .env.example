# Copy to .env (git-ignored) to run `npm run ask`. Never commit a real key.
ANTHROPIC_API_KEY=
# Optional. Default claude-sonnet-5-5.
ELLIS_MODEL=
# Optional. A read-only platform checkout; checks that need it answer "unavailable" without it.
ELLIS_PLATFORM_SOURCE=
# Optional. Model calls per question, 1 to 20. Default 8.
ELLIS_MAX_STEPS=
